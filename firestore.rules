rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /transactions/{transactionId} {
      // Anyone can read (for the scoreboard)
      allow read: if true;
      
      // Only allow creation if data is valid and status is pending
      allow create: if request.resource.data.status == 'pending'
                    && request.resource.data.totalAmount > 0
                    && request.resource.data.guestName is string
                    && request.resource.data.guestName.size() < 100
                    && (request.resource.data.listChosen == 'Groom' || request.resource.data.listChosen == 'Bride');
      
      // Only authenticated admin can update or delete
      allow update, delete: if request.auth != null;
    }
  }
}
