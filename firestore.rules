rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Admin config document — only admins can read/write
    match /config/admins {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.token.email in resource.data.emails;
    }

    match /transactions/{transactionId} {
      // Anyone can read (for the scoreboard)
      allow read: if true;
      
      // Only allow creation if data is valid and status is pending
      allow create: if request.resource.data.status == 'pending'
                    && request.resource.data.totalAmount > 0
                    && request.resource.data.guestName is string
                    && request.resource.data.guestName.size() < 100
                    && (request.resource.data.listChosen == 'Groom' || request.resource.data.listChosen == 'Bride');
      
      // Only the authorized admins can update or delete
      allow update, delete: if request.auth != null
                            && request.auth.token.email in get(/databases/$(database)/documents/config/admins).data.emails;
    }
  }
}
