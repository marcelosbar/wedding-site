rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Admin config document — only admins can read/write, or anyone if the doc doesn't exist yet (allows local auto-seeding)
    match /config/admins {
      allow read: if request.auth != null
                   && request.auth.token.email_verified == true
                   && resource != null
                   && request.auth.token.email in resource.data.emails;
      allow write: if !exists(/databases/$(database)/documents/config/admins) || (request.auth != null
                    && request.auth.token.email_verified == true
                    && resource != null
                    && request.auth.token.email in resource.data.emails);
    }

    match /transactions/{transactionId} {
      // Anyone can read (for the scoreboard)
      allow read: if true;
      
      allow create: if request.resource.data.keys().hasOnly(['guestName', 'totalAmount', 'listChosen', 'status', 'timestamp', 'message', 'isPublic', 'items'])
                    && request.resource.data.status == 'pending'
                    && request.resource.data.totalAmount is int
                    && request.resource.data.totalAmount > 0
                    && request.resource.data.totalAmount <= 5000
                    && request.resource.data.guestName is string
                    && request.resource.data.guestName.size() > 0
                    && request.resource.data.guestName.size() < 100
                    && (request.resource.data.listChosen == 'Groom' || request.resource.data.listChosen == 'Bride')
                    && request.resource.data.timestamp is string
                    && request.resource.data.message is string
                    && request.resource.data.message.size() <= 500
                    && request.resource.data.isPublic is bool
                    && request.resource.data.items is list
                    && request.resource.data.items.size() <= 50;
      
      // Only the authorized admins can update
      allow update: if request.auth != null
                    && request.auth.token.email_verified == true
                    && request.auth.token.email in get(/databases/$(database)/documents/config/admins).data.emails
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
      
      // Only the authorized admins can delete
      allow delete: if request.auth != null
                    && request.auth.token.email_verified == true
                    && request.auth.token.email in get(/databases/$(database)/documents/config/admins).data.emails;
    }
  }
}
