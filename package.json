{
  "name": "wedding-site",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "dev": "concurrently \"vite\" \"npx firebase emulators:start --only auth,firestore,functions --project demo-wedding-site\"",
    "dev:site": "vite",
    "emulators": "npx firebase emulators:start --only auth,firestore,functions --project demo-wedding-site",
    "preview:secure": "pnpm run build && npx firebase emulators:start",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "test:integration": "npx firebase emulators:exec --only firestore \"npx vitest run --config vitest.integration.config.js\""
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "@vitest/coverage-v8": "^4.1.8",
    "concurrently": "^10.0.3",
    "firebase-tools": "^15.24.0",
    "jsdom": "^29.1.1",
    "vite": "^8.1.4",
    "vitest": "^4.1.8"
  },
  "dependencies": {
    "firebase": "^12.16.0",
    "qrcode": "^1.5.4"
  },
  "pnpm": {
    "//": "Security overrides for transitive deps that upstream hasn't updated yet. Remove each entry once `pnpm why <pkg>` no longer shows vulnerable versions without it.",
    "overrides": {
      "uuid": ">=11.1.1"
    }
  }
}
