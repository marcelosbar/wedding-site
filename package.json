{
  "name": "wedding-site",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"vite\" \"npx firebase emulators:start --only auth,firestore\"",
    "dev:site": "vite",
    "emulators": "npx firebase emulators:start --only auth,firestore",
    "preview:secure": "npm run build && npx firebase emulators:start",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "test:integration": "npx firebase emulators:exec --only firestore \"npx vitest run --config vitest.integration.config.js\""
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "@vitest/coverage-v8": "^4.1.8",
    "concurrently": "^10.0.3",
    "firebase-tools": "^15.19.1",
    "jsdom": "^29.1.1",
    "vite": "^8.0.16",
    "vitest": "^4.1.8"
  },
  "dependencies": {
    "firebase": "^12.14.0",
    "qrcode": "^1.5.4"
  }
}
